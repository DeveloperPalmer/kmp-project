CREATE TABLE City (
  id INTEGER NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  country TEXT NOT NULL,
  lat REAL NOT NULL,
  lon REAL NOT NULL,
  pop INTEGER NOT NULL
);

getCity:
SELECT name, country, pop FROM City WHERE id = ?;

insert:
INSERT OR REPLACE INTO City(id, name, country, lat, lon, pop)
VALUES (?, ?, ?, ?, ?, ?);
